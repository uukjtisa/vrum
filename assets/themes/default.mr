import "engine_sim.mr"

unit_names units()
public node use_default_theme {
    input start_fullscreen: false;
    input speed_units: units.mph;
    input pressure_units: units.inHg;
    input torque_units: units.lb_ft;
    input power_units: units.hp;

    set_application_settings(
        start_fullscreen: start_fullscreen,
        speed_units: speed_units,
        pressure_units: pressure_units,
        torque_units: torque_units,
        power_units: power_units,
        
        // VRUM dark theme. Dark-only by design -- this is an instrument panel,
        // and the gauges, the oscilloscope trace and the hot-parts shading are
        // all drawn as light-on-dark, so a light mode would need every one of
        // them re-authored rather than just inverting two values.
        //
        // Background is a near-black with a slight blue cast rather than pure
        // black: it keeps the panel frames visible without them glowing, and
        // stops OLED-style smearing on the moving oscilloscope trace.
        // Foreground is deliberately off-white -- full 0xFFFFFF against this
        // background is harsh at the small label sizes.
        color_background: 0x0B0D10,
        color_foreground: 0xE8ECF2,
        color_shadow: 0x05070A,

        // Accents are held at similar perceived lightness so no single readout
        // grabs the eye by accident; the red is the exception, reserved for
        // redline and recording.
        color_highlight1: 0xFF5A4E,
        color_highlight2: 0xE8ECF2,
        color_pink: 0xF48FB1,
        color_red: 0xFF5A4E,
        color_orange: 0xFFA24B,
        color_yellow: 0xFFD24A,
        color_blue: 0x63D2E8,
        color_green: 0x9FE05B
    )
}
