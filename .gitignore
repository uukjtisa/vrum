# Ignore user's workspace
workspace/

# Build directory
build/

# VRUM: locally-provisioned build dependencies (see build.bat)
dependencies/vcpkg/
dependencies/tools/

# VRUM: reference recordings (third-party audio, large; owner-supplied)
assets/reference/

# VRUM: transient build/smoke-test artifacts
build_log.txt
smoke_out.txt
smoke_err.txt
vrum_screenshot.png

# clangd cache and code completion files
.cache
compile_commands.json

# Blender temporary files
*.blend1

# VRUM: generated by in-app engine switching (PageUp/PageDown)
assets/_vrum_current.mr

# VRUM: published root launcher + its runtime DLLs, regenerated by build.bat.
# Binaries do not belong in the source tree; delta.conf is generated alongside.
/VRUM.exe
/VRUM-bench.exe
/*.dll
/delta.conf
